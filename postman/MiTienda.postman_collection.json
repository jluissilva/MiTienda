            "type": "text/javascript",
            "exec": [
              "pm.test('Compra consultada', function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test('Total = 33600', function () { pm.expect(parseFloat(j.compra.valortotal_compra)).to.eql(33600); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Stock NO debe cambiar en borrador",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/productos/{{id_producto}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "productos",
            "{{id_producto}}"
          ]
        },
        "description": "Si esta prueba falla, queda algún trigger actualizar_producto_compra_* activo. Revisa SHOW TRIGGERS."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Producto encontrado', function () { pm.response.to.have.status(200); });",
              "const stock = pm.response.json().stock_producto;",
              "const inicial = Number(pm.collectionVariables.get('stock_inicial'));",
              "pm.test('Stock igual al inicial (' + inicial + ')', function () { pm.expect(stock).to.eql(inicial); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - CONFIRMAR compra",
      "request": {
        "method": "POST",
        "header": [],
