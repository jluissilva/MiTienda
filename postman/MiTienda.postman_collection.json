            ]
          }
        }
      ]
    },
    {
      "name": "09 - Stock = inicial + 12",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/productos/{{id_producto}}",
          "host": [
