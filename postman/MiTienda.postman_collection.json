{
  "info": {
    "name": "MiTienda - Flujo de compras (borrador / confirmar / corregir)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden (Runner). Usa el producto de la variable id_producto. Deja la compra de prueba confirmada con 15 unidades al final."
  },
  "item": [
    {
      "name": "00 - Servidor activo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El servidor responde 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Crear compra (borrador)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/compras",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "compras"
          ]
        },
        "description": "Usa TRANSFERENCIA a propósito para no activar el trigger de caja durante estas pruebas.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fecha_compra\": \"2026-09-19 10:00:00\",\n  \"id_proveedor\": 1,\n  \"id_usuario\": 1,\n  \"descripciongeneral_compra\": \"Prueba flujo borrador-confirmar-corregir\",\n  \"forma_pagocompra\": \"TRANSFERENCIA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Compra creada (201)', function () { pm.response.to.have.status(201); });",
              "const j = pm.response.json();",
              "pm.collectionVariables.set('id_compra', j.id_compra);",
              "console.log('id_compra =', j.id_compra);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Stock inicial del producto",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/productos/{{id_producto}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "productos",
            "{{id_producto}}"
          ]
        },
        "description": "Guarda el stock actual en la variable stock_inicial para compararlo en los pasos siguientes."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Producto encontrado', function () { pm.response.to.have.status(200); });",
              "const p = pm.response.json();",
              "pm.collectionVariables.set('stock_inicial', p.stock_producto);",
              "console.log('Stock inicial:', p.stock_producto);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Agregar línea: 10 Kg",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/compras/{{id_compra}}/detalles",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "compras",
            "{{id_compra}}",
            "detalles"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_producto\": \"{{id_producto}}\",\n  \"und_medida\": \"Kg\",\n  \"cantidad_producto\": 10,\n  \"preciounitario_compra\": 2800,\n  \"preciounitario_venta\": 3600\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Línea agregada (201)', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('id_detallecompra', pm.response.json().id_detallecompra);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Ver compra (total 28.000)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/compras/{{id_compra}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "compras",
            "{{id_compra}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Compra consultada', function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test('Total = 28000', function () { pm.expect(parseFloat(j.compra.valortotal_compra)).to.eql(28000); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Editar línea en borrador: 10 -> 12",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/compras/{{id_compra}}/detalles/{{id_detallecompra}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "compras",
            "{{id_compra}}",
            "detalles",
            "{{id_detallecompra}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cantidad_producto\": 12\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Edición permitida en borrador (200)', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Ver compra (total 33.600)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/compras/{{id_compra}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "compras",
            "{{id_compra}}"
